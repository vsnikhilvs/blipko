# --- Database (required) ---
# Postgres connection string. Must include the postgresql:// scheme for Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blipko"

# --- Server (optional) ---
# PORT defaults to 4000; NODE_ENV defaults to "development".
PORT=4000
NODE_ENV=development

# --- AI parsing (required) ---
# Both keys are required at boot — the bot exits if either is blank.
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_PARSER_MODEL="gpt-4o-mini"

# --- Assistant lane (optional) ---
# Tool-calling assistant that answers free-form questions ("am I spending more
# than last month?", "can I afford a 5000 phone?"). Off by default: with the
# flag off or the key blank, questions fall back to the existing query agent,
# so an unset key degrades instead of breaking the bot at boot.
ASSISTANT_ENABLED="false"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Voice transcription (optional) ---
# If blank, voice messages are disabled and users are asked to type instead.
SARVAM_API_KEY=""

# --- Telegram (required) ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
# Shared secret Telegram sends back on each webhook call (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET="required_secret_for_webhook_verification"

# --- Scheduling / web (optional; have defaults) ---
# Public dashboard URL used in the bot's onboarding hand-off.
WEB_APP_URL="https://blipko.lol"
# Secret guarding POST /api/cron/tick (the hourly Railway cron sends it as x-cron-secret).
CRON_SECRET="set_a_strong_secret_in_prod"
